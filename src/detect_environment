#!/bin/sh
# detect_environment - Emit usable sources as CSV for build.awk
# The source registry (data/source_commands.csv) carries each source's own
# probe command (detect_cmd); this script only orchestrates detection.
# Options:
#   --level N : plan level (0=base, 1=work, 2=media, 3=all, default 0)

LEVEL=0

# Parse arguments
while [ $# -gt 0 ]; do
    case "$1" in
        --level)
            LEVEL="$2"
            shift 2
            ;;
        *)
            shift
            ;;
    esac
done

# Check if we have root/sudo access
has_root_access() {
    if [ "$(id -u)" -eq 0 ]; then
        return 0
    fi
    sudo -n true 2>/dev/null
}

# Check if SSH keys are available
has_ssh_key() {
    if [ -d "$HOME/.ssh" ]; then
        for key in "$HOME/.ssh/id_rsa" "$HOME/.ssh/id_ed25519" "$HOME/.ssh/id_ecdsa"; do
            if [ -f "$key" ]; then
                return 0
            fi
        done
    fi
    return 1
}

# Metadata first (parsed as such by build.awk)
echo "level,$LEVEL"
if has_root_access; then
    echo "root,yes"
else
    echo "root,no"
fi
if has_ssh_key; then
    echo "ssh,yes"
else
    echo "ssh,no"
fi

# Probe the source registry in its declared order.
# Registry columns: source,order,detect_cmd,...
awk -F, '
    FNR == 1 { next }
    $1 == "" || $1 == "source" || $1 ~ /^#/ { next }
    { print $2, $1, $3 }
' "$data_directory/source_commands.csv" | sort -n | while read -r prio src detect_cmd; do
    [ -n "$detect_cmd" ] || continue
    eval "$detect_cmd" >/dev/null 2>&1 && echo "$src"
done
